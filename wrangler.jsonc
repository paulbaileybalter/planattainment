{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Rename this to whatever you want the Cloudflare Worker project to be called.
  "name": "balter-production-attainment",
  "main": "src/worker.js",
  // Bump this to today's date if you fork/reuse this config later.
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Unconditionally invoke the Worker for every request (including static
    // files) so the session-cookie check always runs before anything is served.
    "run_worker_first": true
  },
  "vars": {
    // The Google Sheet the dashboard reads automatically. This is the long ID
    // in the sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
    // It is not a password, but anyone with it can open the sheet if it is
    // shared as "Anyone with the link", so keep this repo private.
    "SHEET_ID": "1nEK-2VbBsQW99XDpZ3MTuPOiy_0x_K9qdqyGFMMFRIo"
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
